# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.log
.DS_Store
.idea/
.vscode/

# Site: runtime generated files (seed defaults are generated by PHP)
/Сайт/private/data/*
!/Сайт/private/data/.gitkeep
!/Сайт/private/data/.htaccess

# Forum and Wiki state and credentials
/Форум/storage/*
!/Форум/storage/.gitkeep
/Вики/storage/*
!/Вики/storage/.gitkeep

# Pawn/open.mp build and local databases
/Игра/gamemodes/*.amx
/Игра/dependencies/
/Игра/plugins/
/Игра/components/
/Игра/.sampctl/
/Игра/scriptfiles/*.db
/Игра/scriptfiles/*.db-*
/Игра/scriptfiles/*.sqlite*
/Игра/config.json
/Игра/server.cfg
/Игра/logs/
